# cp config.env.example config.env して自分の環境に合わせて編集する
# config.env は .gitignore 済み

# ---------------------------------------------------------------------------
# リソース名のプレフィックス
#
# 同じ AWS アカウントを複数人で共有して検証する場合、ここを各自で変えることで
# スタック名・Lambda 関数名・API 名の衝突を避けられる。
#
# 制約: 英字で始まり、英数字とハイフンのみ、12 文字以内（小文字に正規化される）
# 未設定の場合は $USER から自動生成する
# ---------------------------------------------------------------------------
PREFIX=

# 呼び出し元アカウント（Lambda を置く方）
ACCOUNT_A_ID=111111111111

# API 提供側アカウント
ACCOUNT_B_ID=222222222222

# AWS CLI プロファイル名
PROFILE_A=account-a
PROFILE_B=account-b

# リージョン（A / B とも同一リージョンを前提）
REGION=ap-northeast-1
